function obj = plotAdcDynamicSimulationResult( p, adcDynamicPerformanceMetrics )
  %% plot FFT
  obj = figure;
  plot( adcDynamicPerformanceMetrics.frequency / 1e6, adcDynamicPerformanceMetrics.spectrumDb, 'b', 'LineWidth', 2.5 );
  xlabel( 'Frequency (MHz)' );
  ylabel( 'Magnitude (dB)' );
  text( 0.65 * p.fs / 2 / 1e6, -10, sprintf( 'SNDR = %.2f dB\nENOB = %.2f bit', adcDynamicPerformanceMetrics.sndr, adcDynamicPerformanceMetrics.enob ) ...);
  title( 'ADC 频谱图 ' );
  grid on;
end